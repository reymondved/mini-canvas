# Copy this file to ".env.test" for "npm test". It's ignored by Git.
# Tests WIPE and refill this database and folder, so never point them at your real ones.

SESSION_SECRET=any-long-random-string-for-tests

# Same app user as .env, but a separate database: mini_canvas_test
DATABASE_URL=postgres://mini_canvas_app:replace-me@localhost:5432/mini_canvas_test

UPLOAD_DIR=uploads-test
