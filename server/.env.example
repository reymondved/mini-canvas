# Copy this file to ".env" and fill in real values.
# .env is ignored by Git, so your secrets never reach GitHub.

# Port the Express server listens on (the Vite proxy expects 3001)
PORT=3001

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# How the server connects to PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Use the limited app user (not the postgres superuser).
DATABASE_URL=postgres://mini_canvas_app:replace-me@localhost:5432/mini_canvas
