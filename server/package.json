{
  "name": "mini-canvas-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:migrate": "node --env-file=.env db/migrate.js",
    "db:rollback": "node --env-file=.env db/migrate.js down",
    "db:seed": "node --env-file=.env db/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "connect-pg-simple": "10.0.0",
    "express": "5.1.0",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
